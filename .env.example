.env.example
# SABA Configuration

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo  # or gpt-3.5-turbo

# Server Configuration
HOST=127.0.0.1
PORT=8080
API_PORT=8090

# Database
DATABASE_PATH=./saba.db
DB_BACKUP_INTERVAL=3600  # seconds

# SABA Gateway
SABA_GATEWAY_URL=http://127.0.0.1:8080
SABA_ORCHESTRATOR_URL=http://127.0.0.1:9000

# OpenAI Agents Service
OPENAI_AGENTS_URL=http://127.0.0.1:8090
OPENAI_MAX_TURNS=12

# Logging
LOG_LEVEL=info
LOG_FILE=./saba.log

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_AUTOMATIONS=true
ENABLE_BUSINESS_ANALYZER=true
ENABLE_CAPABILITY_ENGINE=true

# Performance
MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT=300  # seconds
CACHE_ENABLED=true
CACHE_TTL=3600  # seconds

# Security
API_KEY_REQUIRED=false
ALLOW_CORS=true
CORS_ORIGINS=*
